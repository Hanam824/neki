import { Palette } from "std-widgets.slint";
import { AppState } from "state.slint";
import { LogPanel, NavItem } from "components.slint";
import { ProjectsPage } from "pages/projects.slint";
import { BuildsPage } from "pages/builds.slint";
import { StorePage } from "pages/store.slint";
import { ProfilesPage } from "pages/profiles.slint";
import { SettingsPage } from "pages/settings.slint";

export { AppState, BuildItem, GenerationItem, GraphNode, KeyValue, LogEntry, PathDetail, PathItem, ProjectDetail, ProjectItem } from "state.slint";

export component AppWindow inherits Window {
    title: "Neki Desktop App";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 820px;
    min-height: 540px;
    background: Palette.background;

    HorizontalLayout {
        Rectangle {
            width: 190px;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                alignment: start;
                Text {
                    text: "Neki";
                    font-size: 22px;
                    font-weight: 800;
                }
                Text {
                    text: "Desktop App";
                    font-size: 12px;
                    opacity: 0.7;
                }
                Rectangle { height: 16px; }
                for item[i] in ["Projects", "Builds", "Store", "Profiles", "Settings"]: NavItem {
                    label: item;
                    active: AppState.page == i;
                    clicked => {
                        AppState.page = i;
                        // The store list is loaded when first shown.
                        if (i == 2 && AppState.store-paths.length == 0 && !AppState.busy) {
                            AppState.load-store();
                        }
                        if (i == 3 && AppState.generations.length == 0 && !AppState.busy) {
                            AppState.profile-action("history", AppState.profile-name, "");
                        }
                    }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            VerticalLayout {
                vertical-stretch: 1;
                padding: 16px;
                if AppState.page == 0: ProjectsPage { }
                if AppState.page == 1: BuildsPage { }
                if AppState.page == 2: StorePage { }
                if AppState.page == 3: ProfilesPage { }
                if AppState.page == 4: SettingsPage { }
            }
            LogPanel {
                height: 170px;
            }
        }
    }
}
