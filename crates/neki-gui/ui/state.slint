// State shared between the UI and Rust (`AppState` global).

export struct ProjectItem {
    name: string,
    // Project root for loaded projects, the error message otherwise.
    status: string,
    ok: bool,
    // "not built", "built" or "changed since the last build".
    build-state: string,
}

export struct KeyValue {
    key: string,
    value: string,
}

export struct LogEntry {
    // "info", "ok" or "error".
    level: string,
    text: string,
}

export struct ProjectDetail {
    name: string,
    description: string,
    root: string,
    lock-status: string,
    package-names: [string],
    inputs: [KeyValue],
    packages: [KeyValue],
    dev-shell: [KeyValue],
}

export struct BuildItem {
    drv: string,
    name: string,
    // "running", "built", "failed" or "downloaded".
    status: string,
}

export struct GraphNode {
    drv: string,
    name: string,
    // "waiting", "running", "built" or "failed".
    status: string,
    x: length,
    y: length,
}

export struct PathItem {
    name: string,
    hash: string,
    size: string,
}

export struct PathDetail {
    path: string,
    nar-hash: string,
    nar-size: string,
    closure-size: string,
    deriver: string,
    references: [string],
    // The closure as an indented tree, one path per line.
    tree: [string],
}

export struct GenerationItem {
    number: int,
    created: string,
    packages: string,
    current: bool,
}

export global AppState {
    // 0 = projects, 1 = builds, 2 = store, 3 = profiles, 4 = settings.
    in-out property <int> page: 0;
    in-out property <bool> busy: false;
    in-out property <string> busy-label;
    // Newest entry first.
    in-out property <[LogEntry]> log;

    // Projects
    in-out property <[ProjectItem]> projects;
    in-out property <int> selected-project: -1;
    in-out property <ProjectDetail> detail;
    in-out property <string> manifest-text;
    in-out property <bool> manifest-dirty: false;
    in-out property <string> manifest-error;
    in-out property <string> new-project-path;
    // A project to switch to once unsaved changes are dealt with.
    in-out property <int> pending-select: -1;

    // Builds
    in-out property <[BuildItem]> builds;
    in-out property <int> selected-build: -1;
    in-out property <[string]> build-log;
    // Whether the last build failed and can be started again.
    in-out property <bool> can-retry: false;
    // 0 = log, 1 = graph.
    in-out property <int> builds-tab: 0;
    in-out property <[GraphNode]> graph-nodes;
    // Path commands for every line between nodes.
    in-out property <string> graph-edges;
    in-out property <float> graph-width;
    in-out property <float> graph-height;

    // Store
    in-out property <string> store-dir;
    in-out property <string> store-filter;
    in-out property <[PathItem]> store-paths;
    in-out property <string> store-summary;
    in-out property <int> selected-path: -1;
    in-out property <PathDetail> path-detail;
    in-out property <string> why-target;
    in-out property <[string]> why-chains;
    in-out property <[KeyValue]> gc-preview;
    in-out property <string> gc-summary;

    // Profiles
    in-out property <string> profile-name: "default";
    in-out property <[string]> profiles;
    in-out property <string> profile-packages;
    in-out property <[GenerationItem]> generations;
    in-out property <string> current-link;
    in-out property <[KeyValue]> generation-diff;

    in-out property <[KeyValue]> settings;

    callback add-project(string);
    callback create-project(string);
    callback pick-folder();
    callback remove-project(int);
    callback select-project(int);
    callback refresh-projects();
    callback save-manifest(string);
    callback reload-manifest();
    callback build-project(string);
    callback lock-project();
    callback open-dev-shell();

    callback select-build(int);
    callback cancel-build();
    callback retry-build();
    callback select-build-drv(string);

    // "verify", "repair", "gc-preview", "gc" or "optimise".
    callback store-action(string);
    callback load-store();
    callback filter-store(string);
    callback select-path(int);
    callback why-depends(string);

    // action ("history", "rollback", "install", "remove" or "switch"),
    // profile, packages (or the generation number for "switch").
    callback profile-action(string, string, string);
    callback diff-generations(int, int);
    callback clear-log();
}
