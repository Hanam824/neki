import { Button, ComboBox, LineEdit, ListView, Palette, ScrollView, TabWidget, TextEdit } from "std-widgets.slint";
import { AppState } from "../state.slint";
import { Colors, KeyValueList, SectionTitle } from "../components.slint";

// A labelled field of the Form tab.
component FormRow inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;
    Text {
        text: root.label;
        width: 100px;
        vertical-alignment: center;
    }
    @children
}

component ProjectDetailView inherits VerticalLayout {
    spacing: 10px;

    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            horizontal-stretch: 1;
            SectionTitle {
                text: AppState.detail.name;
                font-size: 20px;
            }
            Text {
                text: AppState.detail.root;
                font-size: 11px;
                opacity: 0.7;
                overflow: elide;
            }
        }
        package := ComboBox {
            width: 160px;
            model: AppState.detail.package-names;
            enabled: AppState.detail.package-names.length > 0;
        }
        Button {
            text: "Build";
            primary: true;
            enabled: !AppState.busy && AppState.detail.package-names.length > 0;
            clicked => {
                AppState.build-project(package.current-value);
            }
        }
        Button {
            text: "Update lock";
            enabled: !AppState.busy;
            clicked => {
                AppState.lock-project();
            }
        }
        Button {
            text: "Open dev shell";
            enabled: !AppState.busy;
            clicked => {
                AppState.open-dev-shell();
            }
        }
        Button {
            text: "Remove";
            clicked => {
                AppState.remove-project(AppState.selected-project);
            }
        }
    }

    if AppState.detail.description != "": Text {
        text: AppState.detail.description;
        wrap: word-wrap;
    }

    TabWidget {
        vertical-stretch: 1;
        current-index <=> AppState.project-tab;
        changed current-index => {
            if (self.current-index == 2) {
                AppState.load-form();
            }
        }

        Tab {
            title: "Overview";
            ScrollView {
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    alignment: start;
                    SectionTitle { text: "Lock"; }
                    Text {
                        text: AppState.detail.lock-status;
                        wrap: word-wrap;
                    }
                    SectionTitle { text: "Inputs"; }
                    KeyValueList { items: AppState.detail.inputs; }
                    SectionTitle { text: "Packages"; }
                    KeyValueList { items: AppState.detail.packages; }
                    SectionTitle { text: "Dev shell"; }
                    KeyValueList { items: AppState.detail.dev-shell; }
                }
            }
        }

        Tab {
            title: "neki.toml";
            VerticalLayout {
                padding: 8px;
                spacing: 8px;
                TextEdit {
                    vertical-stretch: 1;
                    font-size: 13px;
                    text <=> AppState.manifest-text;
                    edited(text) => {
                        AppState.manifest-dirty = true;
                    }
                }
                if AppState.manifest-error != "": Text {
                    text: AppState.manifest-error;
                    color: Colors.error;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: AppState.manifest-dirty ? "Unsaved changes" : "";
                        vertical-alignment: center;
                        opacity: 0.7;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "Revert";
                        enabled: AppState.manifest-dirty;
                        clicked => {
                            AppState.reload-manifest();
                        }
                    }
                    Button {
                        text: "Save";
                        primary: true;
                        enabled: AppState.manifest-dirty;
                        clicked => {
                            AppState.save-manifest(AppState.manifest-text);
                        }
                    }
                }
            }
        }

        Tab {
            title: "Form";
            VerticalLayout {
                padding: 8px;
                spacing: 8px;
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 4px;
                        spacing: 6px;
                        alignment: start;
                        SectionTitle { text: "Project"; }
                        FormRow {
                            label: "Name";
                            LineEdit { text <=> AppState.form-name; }
                        }
                        FormRow {
                            label: "Description";
                            LineEdit { text <=> AppState.form-description; }
                        }

                        SectionTitle { text: "Inputs"; }
                        for input[i] in AppState.form-inputs: HorizontalLayout {
                            spacing: 6px;
                            LineEdit {
                                width: 140px;
                                text: input.name;
                                placeholder-text: "name";
                                edited(text) => {
                                    AppState.form-input-changed(i, text, input.url);
                                }
                            }
                            LineEdit {
                                horizontal-stretch: 1;
                                text: input.url;
                                placeholder-text: "github:owner/repo or path:../dir";
                                edited(text) => {
                                    AppState.form-input-changed(i, input.name, text);
                                }
                            }
                            Button {
                                text: "Remove";
                                clicked => {
                                    AppState.form-input-removed(i);
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Add input";
                                clicked => {
                                    AppState.form-input-changed(-1, "", "");
                                }
                            }
                        }

                        SectionTitle { text: "Dev shell"; }
                        FormRow {
                            label: "Packages";
                            LineEdit {
                                text <=> AppState.form-dev-packages;
                                placeholder-text: "pkgs.jq pkgs.ripgrep";
                            }
                        }
                        FormRow {
                            label: "Environment";
                            TextEdit {
                                height: 70px;
                                text <=> AppState.form-dev-env;
                            }
                        }
                        Text {
                            text: "One KEY=value per line.";
                            font-size: 11px;
                            opacity: 0.7;
                        }

                        SectionTitle { text: "Packages"; }
                        for pkg[i] in AppState.form-packages: VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: pkg.name;
                                font-weight: 600;
                            }
                            FormRow {
                                label: "Source";
                                LineEdit {
                                    text: pkg.src;
                                    edited(text) => {
                                        AppState.form-package-changed(i, text, pkg.build-inputs, pkg.file);
                                    }
                                }
                            }
                            FormRow {
                                label: "Build inputs";
                                LineEdit {
                                    text: pkg.build-inputs;
                                    placeholder-text: "pkgs.rustc pkgs.cargo";
                                    edited(text) => {
                                        AppState.form-package-changed(i, pkg.src, text, pkg.file);
                                    }
                                }
                            }
                            FormRow {
                                label: "File";
                                LineEdit {
                                    text: pkg.file;
                                    placeholder-text: "package.neki (empty: build commands)";
                                    edited(text) => {
                                        AppState.form-package-changed(i, pkg.src, pkg.build-inputs, text);
                                    }
                                }
                            }
                        }
                        Text {
                            text: "Build commands are edited in the neki.toml tab.";
                            font-size: 11px;
                            opacity: 0.7;
                        }
                    }
                }
                if AppState.form-error != "": Text {
                    text: AppState.form-error;
                    color: Colors.error;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: AppState.manifest-dirty ? "Unsaved changes" : "";
                        vertical-alignment: center;
                        opacity: 0.7;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "Reload";
                        clicked => {
                            AppState.load-form();
                        }
                    }
                    Button {
                        text: "Apply to neki.toml";
                        clicked => {
                            AppState.apply-form();
                        }
                    }
                    Button {
                        text: "Save";
                        primary: true;
                        enabled: AppState.manifest-dirty;
                        clicked => {
                            AppState.save-manifest(AppState.manifest-text);
                        }
                    }
                }
            }
        }
    }
}

export component ProjectsPage inherits HorizontalLayout {
    spacing: 16px;

    // Asked before switching away from a project with unsaved edits.
    discard := PopupWindow {
        x: (root.width - 380px) / 2;
        y: 80px;
        width: 380px;
        close-policy: no-auto-close;
        Rectangle {
            background: Palette.background;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 8px;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000040;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text {
                    text: "Discard your unsaved changes to neki.toml?";
                    wrap: word-wrap;
                    font-weight: 600;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Keep editing";
                        clicked => {
                            AppState.pending-select = -1;
                            discard.close();
                        }
                    }
                    Button {
                        text: "Discard";
                        primary: true;
                        clicked => {
                            AppState.select-project(AppState.pending-select);
                            AppState.pending-select = -1;
                            discard.close();
                        }
                    }
                }
            }
        }
    }

    VerticalLayout {
        width: 280px;
        spacing: 8px;

        HorizontalLayout {
            SectionTitle {
                text: "Projects";
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: "Refresh";
                clicked => {
                    AppState.refresh-projects();
                }
            }
        }

        ListView {
            vertical-stretch: 1;
            for item[i] in AppState.projects: Rectangle {
                height: 52px;
                border-radius: 6px;
                background: i == AppState.selected-project ? Palette.selection-background : area.has-hover ? Palette.alternate-background : transparent;
                area := TouchArea {
                    clicked => {
                        if (AppState.manifest-dirty && i != AppState.selected-project) {
                            AppState.pending-select = i;
                            discard.show();
                        } else {
                            AppState.select-project(i);
                        }
                    }
                }
                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;
                    Text {
                        text: item.name;
                        font-weight: 600;
                        overflow: elide;
                        color: i == AppState.selected-project ? Palette.selection-foreground : Palette.foreground;
                    }
                    Text {
                        text: item.ok ? item.build-state + " · " + item.status : item.status;
                        font-size: 11px;
                        overflow: elide;
                        color: item.ok ? (i == AppState.selected-project ? Palette.selection-foreground : Palette.foreground) : Colors.error;
                        opacity: 0.8;
                    }
                }
            }
        }

        Text {
            text: "Project folder";
            font-size: 11px;
        }
        HorizontalLayout {
            spacing: 8px;
            LineEdit {
                placeholder-text: "/path/to/project";
                text <=> AppState.new-project-path;
                accepted(text) => {
                    AppState.add-project(text);
                }
            }
            Button {
                text: "Browse…";
                clicked => {
                    AppState.pick-folder();
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "Add existing";
                horizontal-stretch: 1;
                enabled: AppState.new-project-path != "";
                clicked => {
                    AppState.add-project(AppState.new-project-path);
                }
            }
            Button {
                text: "Create new";
                horizontal-stretch: 1;
                enabled: AppState.new-project-path != "";
                clicked => {
                    AppState.create-project(AppState.new-project-path);
                }
            }
        }
    }

    if AppState.selected-project < 0: Rectangle {
        horizontal-stretch: 1;
        Text {
            text: "Select a project, or add one by its folder path.";
            opacity: 0.7;
        }
    }
    if AppState.selected-project >= 0: ProjectDetailView {
        horizontal-stretch: 1;
    }
}
