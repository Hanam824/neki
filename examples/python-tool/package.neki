# A Python program with two dependencies: idna (pure Python) and markupsafe
# (with compiled C speedups). wheels.neki pins a wheel per system, with
# PyPI's SHA-256s; regenerate it with
#   scripts/python-wheels.py idna==3.20 markupsafe==3.0.4 > wheels.neki
{ inputs, src, name, ... }:

inputs.pkgs.lib.buildPythonApplication {
  inherit name src;
  python = inputs.pkgs.python3;
  wheels = import ./wheels.neki;
}
